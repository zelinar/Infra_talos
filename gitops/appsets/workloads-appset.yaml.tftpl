- apiVersion: argoproj.io/v1alpha1
  kind: ApplicationSet
  metadata:
    name: workloads
    namespace: ${argocd_namespace}
  spec:
    goTemplate: true
    goTemplateOptions: ["missingkey=default"]
    generators:
      - git:
          repoURL: ${gitops_repo_url}
          revision: ${gitops_repo_revision}
          directories:
            - path: ${workloads_path}/*
    template:
      metadata:
        name: '{{ .path.basename }}'
        annotations:
          # Wave 7: Application & Database Workloads (after Core Services Waves 1-3 and Observability Waves 4-6)
          argocd.argoproj.io/sync-wave: "7"
      spec:
        project: workloads
        source:
          repoURL: ${gitops_repo_url}
          targetRevision: ${gitops_repo_revision}
          path: '{{ .path.path }}'
          helm:
            values: |
              {{- $name := .path.basename -}}
              {{- if eq $name "postgres-cluster" }}
              credentialsSecret:
                secretStoreName: ${jsonencode(vault_cluster_secret_store)}
              {{- else if eq $name "llm-stack" }}
              ingress:
                host: ${jsonencode("chat.${base_domain}")}
                tlsSecretName: ${jsonencode(tls_wildcard_secret_name)}
              credentialsSecret:
                secretStoreName: ${jsonencode(vault_cluster_secret_store)}
              {{- end }}
        destination:
          server: https://kubernetes.default.svc
          namespace: '{{ .path.basename }}'
        syncPolicy:
          automated:
            prune: true
            selfHeal: true
          managedNamespaceMetadata:
            labels:
              pod-security.kubernetes.io/enforce: privileged
              pod-security.kubernetes.io/audit: privileged
              pod-security.kubernetes.io/warn: privileged
          retry:
            limit: 5
            backoff:
              duration: 10s
              factor: 2
              maxDuration: 3m
          syncOptions:
            - CreateNamespace=true
            - PrunePropagationPolicy=foreground
            - ServerSideApply=true
            - RespectIgnoreDifferences=true
