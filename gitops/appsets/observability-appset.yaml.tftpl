- apiVersion: argoproj.io/v1alpha1
  kind: ApplicationSet
  metadata:
    name: observability
    namespace: ${argocd_namespace}
  spec:
    goTemplate: true
    goTemplateOptions: ["missingkey=default"]
    generators:
      - git:
          repoURL: ${gitops_repo_url}
          revision: ${gitops_repo_revision}
          directories:
            - path: ${observability_path}/*
    template:
      metadata:
        name: '{{ .path.basename }}'
        annotations:
          # Ordered Sync Waves for the VictoriaMetrics + VictoriaLogs + Alloy + Grafana stack:
          # Wave 4: Operators & CRDs (victoria-metrics-operator, kube-state-metrics)
          # Wave 5: Core Storage Clusters (victoria-metrics VMCluster, victoria-logs VLCluster)
          # Wave 6: Auth Gateway, Agents, Scrapers, Alerting & UI (victoria-common, grafana-alloy, alloy-daemonset, grafana)
          argocd.argoproj.io/sync-wave: >-
            {{- $name := .path.basename -}}
            {{- if or (eq $name "victoria-metrics-operator") (eq $name "kube-state-metrics") -}}
              4
            {{- else if or (eq $name "victoria-metrics") (eq $name "victoria-logs") -}}
              5
            {{- else -}}
              6
            {{- end -}}
      spec:
        project: observability
        source:
          repoURL: ${gitops_repo_url}
          targetRevision: ${gitops_repo_revision}
          path: '{{ .path.path }}'
          helm:
            values: |
              {{- $name := .path.basename -}}
              {{- if eq $name "victoria-metrics" }}
              victoria-metrics:
                ingress:
                  ingressDomain: ${jsonencode(base_domain)}
              {{- else if eq $name "victoria-logs" }}
              victoria-logs:
                ingress:
                  ingressDomain: ${jsonencode(base_domain)}
              {{- else if eq $name "victoria-common" }}
              victoria-common:
                staticSecrets:
                  alloyActiveToken: ${jsonencode(alloy_active_token)}
                  victoriaActiveToken: ${jsonencode(victoria_active_token)}
                credentialsSecret:
                  secretStoreName: ${jsonencode(vault_cluster_secret_store)}
                ingress:
                  ingressDomain: ${jsonencode(base_domain)}
                  tlsSecretName: ${jsonencode(tls_wildcard_secret_name)}
              {{- else if eq $name "grafana-alloy" }}
              global:
                cluster:
                  name: ${jsonencode(cluster_name)}
                  environment: ${jsonencode(cluster_environment)}
                  region: ${jsonencode(cluster_region)}
                  owner: ${jsonencode(cluster_owner)}
              alloy-external:
                secretStoreRef:
                  name: ${jsonencode(vault_cluster_secret_store)}
                customIngresses:
                  defaults:
                    domain: ${jsonencode(base_domain)}
                    tlsSecret: ${jsonencode(tls_wildcard_secret_name)}
                  entries:
                    logs:
                      host: ${jsonencode("alloy-logs.${base_domain}")}
                    metrics:
                      host: ${jsonencode("alloy-metrics.${base_domain}")}
              configExternal:
                snmp:
                  defaultLabels:
                    owner: ${jsonencode(cluster_owner)}
              {{- else if eq $name "alloy-daemonset" }}
              global:
                cluster:
                  name: ${jsonencode(cluster_name)}
                  environment: ${jsonencode(cluster_environment)}
                  region: ${jsonencode(cluster_region)}
                  owner: ${jsonencode(cluster_owner)}
              {{- else if eq $name "grafana" }}
              credentialsSecret:
                secretStoreName: ${jsonencode(vault_cluster_secret_store)}
              grafana:
                ingress:
                  hosts:
                    - ${jsonencode("grafana.${base_domain}")}
                  tls:
                    - hosts:
                        - ${jsonencode("grafana.${base_domain}")}
                      secretName: ${jsonencode(tls_wildcard_secret_name)}
                grafana.ini:
                  server:
                    root_url: ${jsonencode("https://grafana.${base_domain}/")}
                    domain: ${jsonencode("grafana.${base_domain}")}
              {{- end }}
        destination:
          server: https://kubernetes.default.svc
          namespace: monitoring
        syncPolicy:
          automated:
            prune: true
            selfHeal: true
          managedNamespaceMetadata:
            labels:
              pod-security.kubernetes.io/enforce: privileged
              pod-security.kubernetes.io/audit: privileged
              pod-security.kubernetes.io/warn: privileged
          retry:
            limit: 5
            backoff:
              duration: 10s
              factor: 2
              maxDuration: 3m
          syncOptions:
            - CreateNamespace=true
            - PrunePropagationPolicy=foreground
            - ServerSideApply=true
            - RespectIgnoreDifferences=true
