machine:
  install:
    disk: /dev/sda
    image: ${installer_image}
    wipe: false
  network:
    hostname: ${hostname}
    nameservers:
%{ for ns in dns_servers ~}
      - ${ns}
%{ endfor ~}
    interfaces:
      - deviceSelector:
          driver: virtio_net
        dhcp: false
        addresses:
          - ${ip}/${cidr_prefix}
        routes:
          - network: 0.0.0.0/0
            gateway: ${gateway}
  kubelet:
    extraMounts:
      - destination: /var/lib/longhorn
        type: bind
        source: /var/lib/longhorn
        options:
          - bind
          - rshared
          - rw
%{ if has_data_disk ~}
  disks:
    - device: /dev/sdb
      partitions:
        - mountpoint: /var/lib/longhorn
%{ endif ~}
%{ if enable_nvidia_gpu && has_gpu ~}
  kernel:
    modules:
      - name: nvidia
      - name: nvidia_uvm
      - name: nvidia_drm
      - name: nvidia_modeset
  sysctls:
    net.core.bpf_jit_harden: "1"
%{ endif ~}
%{ if is_gpu_worker ~}
  nodeLabels:
    gpu.internal.cloud/nvidia: "true"
%{ endif ~}

cluster:
  network:
    podSubnets:
      - ${pod_subnet}
    serviceSubnets:
      - ${service_subnet}
