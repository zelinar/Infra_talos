# ==============================================================================
# Proxmox Connection
# ==============================================================================
pm_api_url          = "https://10.10.20.20:8006"
pm_api_token_id     = "terraform@pve!terraform-token"
pm_api_token_secret = "00000000-0000-0000-0000-000000000000" # Replace with your actual Proxmox token UUID
pm_tls_insecure     = true

proxmox_node          = "homelab-server"
proxmox_iso_datastore = "local"
proxmox_vm_datastore  = "VM-storage"

# ==============================================================================
# Talos & Kubernetes Versions
# ==============================================================================
talos_version      = "v1.9.4"
kubernetes_version = "1.32.2"
cni_provider       = "cilium" # "cilium" or "flannel"

# ==============================================================================
# Cluster & Networking
# ==============================================================================
cluster_name        = "homelab-talos"
cluster_vip         = "" # Optional HA VIP (e.g. "10.10.20.109") if using multiple control planes
network_bridge      = "vmbr0"
network_cidr_prefix = 24
network_gateway     = "10.10.20.1"
dns_servers         = ["10.10.20.1", "1.1.1.1", "8.8.8.8"]

pod_subnet     = "10.244.0.0/16"
service_subnet = "10.96.0.0/12"

# ==============================================================================
# Platform Domain, LoadBalancer Pool & GitOps Configuration (Layers 2–4)
# ==============================================================================
base_domain         = "internal.cloud"
cluster_environment = "homelab"
cluster_region      = "onprem"
cluster_owner       = "homelab"

metallb_ip_pool_start = "10.10.20.125"
metallb_ip_pool_end   = "10.10.20.129"
traefik_lb_ip         = "10.10.20.125" # Defaults to metallb_ip_pool_start if left empty

# TLS Mode: "internal-ca" (self-signed Root CA) or "letsencrypt" (Cloudflare DNS-01 ACME)
tls_mode                  = "internal-ca"
acme_email                = "admin@internal.cloud"
acme_cloudflare_api_token = "" # Required only when tls_mode = "letsencrypt"

gitops_repo_url      = "https://github.com/zelinar/Infra_talos.git"
gitops_repo_revision = "main"

# Initial credentials seeded into Vault KV v2 and synced via External Secrets Operator
grafana_admin_user     = "admin"
grafana_admin_password = "admin"
alloy_active_token     = "homelab-alloy-collect-token-active"
victoria_active_token  = "homelab-victoria-ingest-token-active"
postgres_app_user      = "appuser"
postgres_app_password  = "homelab-postgres-password"

# Optional Day-2 Operations: Longhorn S3 Disaster Recovery Backups & HA Workloads
longhorn_s3_backup_enabled = false
longhorn_s3_backup_target  = "" # e.g. "s3://my-backup-bucket@us-east-1/longhorn"
longhorn_s3_endpoint       = "" # Optional S3 endpoint for MinIO / Cloudflare R2
longhorn_s3_access_key     = ""
longhorn_s3_secret_key     = ""

enable_workloads_appset = false # Set true to deploy Wave 7 workloads (HA CloudNativePG PostgreSQL cluster)

# ==============================================================================
# Cluster Nodes
# ==============================================================================
nodes = {
  "k8s-talos-cp-01" = {
    role              = "controlplane"
    ip                = "10.10.20.110"
    vm_id             = 210
    cores             = 4
    memory_mb         = 4096
    os_disk_size_gb   = 50
    data_disk_size_gb = 0
  }
  "k8s-talos-worker-01" = {
    role              = "worker"
    ip                = "10.10.20.111"
    vm_id             = 211
    cores             = 4
    memory_mb         = 8192
    os_disk_size_gb   = 100
    data_disk_size_gb = 0
  }
  "k8s-talos-worker-02" = {
    role              = "worker"
    ip                = "10.10.20.112"
    vm_id             = 212
    cores             = 4
    memory_mb         = 8192
    os_disk_size_gb   = 100
    data_disk_size_gb = 0
  }
  "k8s-talos-worker-03" = {
    role              = "worker"
    ip                = "10.10.20.113"
    vm_id             = 213
    cores             = 4
    memory_mb         = 8192
    os_disk_size_gb   = 100
    data_disk_size_gb = 0
  }
}
